# ===== Neon PostgreSQL (lấy ở Neon Dashboard > Connect) =====
# DATABASE_URL: chuỗi "Pooled connection" (host có -pooler) - dùng khi chạy app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: chuỗi "Direct connection" (không có -pooler) - Prisma dùng cho migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ===== Server =====
PORT=4000
CORS_ORIGIN="http://localhost:3000"
WEB_BASE_URL="http://localhost:3000"

# ===== Bảo mật (đổi thành chuỗi ngẫu nhiên dài >= 16 ký tự) =====
ADMIN_API_KEY="doi-chuoi-nay-thanh-khoa-admin-rat-dai"
WEBHOOK_API_KEY="doi-chuoi-nay-thanh-khoa-webhook-ngan-hang"

# ===== Tài khoản nhận tiền (VietQR) =====
# BANK_BIN_CODE: mã ngân hàng theo VietQR (MB = MB Bank)
BANK_BIN_CODE="MB"
BANK_NAME="MB Bank (Ngân hàng TMCP Quân Đội)"
BANK_ACCOUNT_NO="190820088888"
BANK_ACCOUNT_NAME="TRUNG UONG HOI GDCSSKCD VN"

# ===== Giao dịch & hội phí =====
PAYMENT_TTL_MINUTES=10
# Hạn quyết toán hội phí hằng năm, định dạng MM-DD
SETTLEMENT_DEADLINE="12-31"

# ===== Gửi email biên lai (bỏ trống SMTP_HOST thì chỉ ghi log, không gửi) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hội GDCSSKCĐ VN <no-reply@vache.org.vn>"
