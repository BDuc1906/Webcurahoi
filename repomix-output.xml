@layer base {
  :root {
    --brand: #991b1b;           /* Đỏ đô Trung ương */
    --brand-hover: #7f1d1d;     /* Đỏ đô đậm */
    --brand-light: #fef2f2;     /* Đỏ ửng nhạt */
    --gold: #b45309;            /* Vàng đồng huy hiệu */
    --gold-light: #fffbeb;      /* Vàng kem */
    --page-bg: #f8fafc;         /* Nền trang */
    --card-bg: #ffffff;         /* Nền thẻ */
    --border-line: #e2e8f0;     /* Viền kẻ */
    --ink-main: #0f172a;        /* Chữ đen mực */
    --ink-muted: #475569;       /* Chữ xám phụ */
  }

  body {
    color: var(--ink-main);
    background-color: var(--page-bg);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 14.5px;
    line-height: 1.6;
  }


  /* Phông chữ có chân chuẩn báo chí chính luận & công báo (Báo Nhân Dân, Báo Điện tử Chính phủ, Nghị định 30/2020/NĐ-CP) */
  h1, h2, h3, .font-serif, .newspaper-headline {
    font-family: 'Noto Serif', 'Times New Roman', Georgia, serif;
    letter-spacing: -0.01em;
  }

  /* Phông chữ không chân chuẩn Cổng thông tin điện tử quốc gia */
  .font-gov, .gov-title {
    font-family: 'Inter', 'Be Vietnam Pro', Arial, sans-serif;
  }
}


/* Các lớp tiện ích bố cục chữ báo chí & công báo */
.newspaper-headline {
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.newspaper-sapo {
  font-family: 'Be Vietnam Pro', Arial, sans-serif;
  font-size: 14.5px;
  line-height: 1.6;
  color: #334155;
  font-weight: 500;
}

.gov-badge {
  font-family: 'Be Vietnam Pro', Arial, sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 11px;
}

/* Ticker tin tức chỉ đạo */
@keyframes marquee {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

.animate-marquee {
  display: inline-block;
  white-space: nowrap;
  animation: marquee 34s linear infinite;
}

.animate-marquee:hover {
  animation-play-state: paused;
}

/* Đường viền tiêu đề chuyên mục chính luận */
.section-header-gov {
  border-left: 4px solid #991b1b;
  padding-left: 10px;
  font-family: 'Times New Roman', 'Be Vietnam Pro', serif;
  font-weight: 700;
  text-transform: uppercase;
  color: #991b1b;
  font-size: 18px;
