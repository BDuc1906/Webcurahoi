<file path=".github/workflows/cd.yml">
name: CD — Deploy Production

on:
  push:
    branches: [main]
  # Cho phép bấm chạy tay từ tab Actions
  workflow_dispatch:

concurrency:
  group: cd-production
  cancel-in-progress: false

jobs:
  # ============================================================
  # JOB 1: Trigger deploy Vercel (Frontend)
  # ============================================================
  deploy-frontend:
    name: Frontend → Vercel
    runs-on: ubuntu-latest

    steps:
      - name: Trigger Vercel Deploy Hook
        run: |
          if [ -z "${{ secrets.VERCEL_DEPLOY_HOOK }}" ]; then
            echo "⚠️ Chưa cấu hình VERCEL_DEPLOY_HOOK"
            echo "Vercel sẽ tự deploy qua Git Integration (không cần webhook)"
            exit 0
          fi
          curl -X POST "${{ secrets.VERCEL_DEPLOY_HOOK }}" \
            -H "Content-Type: application/json" \
            -d '{"ref":"main"}'
          echo "✅ Đã trigger Vercel deploy"

      - name: Thông báo
        run: |
          echo "### 🎨 Frontend" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "🔗 https://webcurahoi.vercel.app" >> $GITHUB_STEP_SUMMARY

  # ============================================================
  # JOB 2: Trigger deploy Railway (Backend)
  # ============================================================
  deploy-backend:
    name: Backend → Railway
    runs-on: ubuntu-latest

    steps:
      - name: Trigger Railway Deploy Hook
        run: |
          if [ -z "${{ secrets.RAILWAY_DEPLOY_HOOK }}" ]; then
            echo "⚠️ Chưa cấu hình RAILWAY_DEPLOY_HOOK"
            echo "Railway sẽ tự deploy qua Git Integration (không cần webhook)"
            exit 0
          fi
          curl -X POST "${{ secrets.RAILWAY_DEPLOY_HOOK }}" \
            -H "Content-Type: application/json"
          echo "✅ Đã trigger Railway deploy"

      - name: Thông báo
        run: |
          echo "### ⚙️ Backend" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "🔗 Railway dashboard: https://railway.app/dashboard" >> $GITHUB_STEP_SUMMARY

  # ============================================================
  # JOB 3: Tổng kết sau khi cả 2 deploy xong
  # ============================================================
  summary:
    name: Tổng kết
    runs-on: ubuntu-latest
    needs: [deploy-frontend, deploy-backend]

    steps:
      - name: In tổng kết
        run: |
          echo "### ✅ Deploy hoàn tất" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Thành phần | Nền tảng | URL |" >> $GITHUB_STEP_SUMMARY
          echo "|-----------|----------|-----|" >> $GITHUB_STEP_SUMMARY
          echo "| Frontend | Vercel | https://webcurahoi.vercel.app |" >> $GITHUB_STEP_SUMMARY
          echo "| Backend | Railway | (Kiểm tra dashboard) |" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Commit:** \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY
          echo "**Tác giả:** @${{ github.actor }}" >> $GITHUB_STEP_SUMMARY
</file>

<file path=".github/workflows/ci.yml">
name: CI — Kiểm tra chất lượng code

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ============================================================
  # FRONTEND — Next.js
  # ============================================================
  frontend:
    name: Frontend — Type check + Build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ./webcurahoi

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: webcurahoi/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Type check (tsc --noEmit)
        run: npx tsc --noEmit

      - name: Lint (Next.js ESLint)
        run: npm run lint
        continue-on-error: true

      - name: Build Next.js
        run: npm run build
        env:
          NEXT_PUBLIC_API_URL: http://localhost:4000/api
          ADMIN_API_KEY: dummy-key-for-build-only

  # ============================================================
  # BACKEND — NestJS
  # ============================================================
  backend:
    name: Backend — Type check + Build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ./webcurahoi/backend

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: webcurahoi/backend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma Client
        run: npx prisma generate
        env:
          DATABASE_URL: postgresql://dummy:dummy@localhost:5432/dummy
          DIRECT_URL: postgresql://dummy:dummy@localhost:5432/dummy

      - name: Type check (tsc --noEmit)
        run: npx tsc --noEmit
        env:
          DATABASE_URL: postgresql://dummy:dummy@localhost:5432/dummy
          DIRECT_URL: postgresql://dummy:dummy@localhost:5432/dummy

      - name: Build NestJS
        run: npm run build
        env:
          DATABASE_URL: postgresql://dummy:dummy@localhost:5432/dummy
          DIRECT_URL: postgresql://dummy:dummy@localhost:5432/dummy
          ADMIN_API_KEY: dummy-admin-key-1234567890
          WEBHOOK_API_KEY: dummy-webhook-key-1234567890
          BANK_ACCOUNT_NO: "190820088888"
          BANK_ACCOUNT_NAME: "TRUNG UONG HOI GDCSSKCD VN"
</file>

