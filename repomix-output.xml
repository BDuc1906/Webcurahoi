  const localBranchUnits = MOCK_ORGANIZATIONS.filter(
    (o) => o.unitType === "BRANCH" || o.unitType === "UNION_BRANCH"
  );

  // Danh sách đơn vị đang hiển thị theo category
  const currentUnits =
    activeCategory === "CENTRAL"
      ? centralUnits
