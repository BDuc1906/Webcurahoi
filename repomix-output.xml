<file path="webcurahoi/hooks/useCountdown.ts">
"use client";

import { useEffect, useRef, useState } from "react";

interface Options {
  seconds: number;
  active: boolean;
  onExpire?: () => void;
}

/**
 * Đếm ngược giây từ `seconds` xuống 0 khi `active = true`.
 * Reset khi `seconds` đổi.
 */
export function useCountdown({ seconds, active, onExpire }: Options) {
  const [remaining, setRemaining] = useState(seconds);
  const onExpireRef = useRef(onExpire);
  const timerRef = useRef<NodeJS.Timeout | null>(null);

  // Cập nhật ref để không đóng băng callback
  useEffect(() => {
    onExpireRef.current = onExpire;
  }, [onExpire]);

  // Reset khi seconds đổi
  useEffect(() => {
    setRemaining(seconds);
  }, [seconds]);

  useEffect(() => {
    if (!active) {
      if (timerRef.current) clearInterval(timerRef.current);
      return;
    }

    timerRef.current = setInterval(() => {
      setRemaining((prev) => {
        const next = Math.max(0, prev - 1);
        if (next === 0) {
          if (timerRef.current) clearInterval(timerRef.current);
          onExpireRef.current?.();
        }
        return next;
      });
    }, 1000);

    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, [active]);

  return remaining;
}

/** Format 600 → "10:00" */
export function formatMmSs(seconds: number): string {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
}
</file>

<file path="webcurahoi/hooks/useLiveTransactions.ts">
"use client";

import { useEffect, useState } from "react";
import { realtimeBus } from "@/lib/realtime-bus";
import { FinanceTransaction } from "@/lib/db/schema";

/**
 * Lắng nghe bus realtime, trả về mảng giao dịch mới (chống trùng theo code).
 * Dùng ở PublicFinanceStatement để đẩy dòng mới lên đầu bảng sao kê.
 */
export function useLiveTransactions(): FinanceTransaction[] {
  const [rows, setRows] = useState<FinanceTransaction[]>([]);

  useEffect(() => {
    const off = realtimeBus.on((tx) => {
      setRows((prev) => {
        if (prev.some((r) => r.code === tx.code)) return prev;
        return [tx, ...prev];
      });
    });
    return off;
  }, []);

  return rows;
}
</file>

<file path="webcurahoi/hooks/usePaymentFlow.ts">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { createPayment } from "@/lib/api-client";
import { realtimeBus } from "@/lib/realtime-bus";
import { playDing } from "@/lib/sound";
import { FinanceTransaction } from "@/lib/db/schema";
import { formatMmSs, useCountdown } from "./useCountdown";

export type Purpose = "DONATION" | "MEMBERSHIP_FEE";
export type FlowStep = "FORM" | "WAITING" | "SUCCESS" | "RECEIPT";

export interface TxState {
  code: string;
  amount: number;
  payerName: string;
  payerEmail: string;
  purpose: Purpose;
  isDemo: boolean;
  bankGateway?: string;
  completedAt?: Date;
}

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ?? "http://localhost:4000/api";
const DEFAULT_TTL_SEC = 600;

export function usePaymentFlow() {
  const [step, setStep] = useState<FlowStep>("FORM");
  const [tx, setTx] = useState<TxState | null>(null);
  const [ttl, setTtl] = useState(DEFAULT_TTL_SEC);

  const sseRef = useRef<EventSource | null>(null);

  // -------------------------------------------------------------------
  // Đếm ngược khi đang WAITING
  // -------------------------------------------------------------------
  const handleExpire = useCallback(() => {
    if (sseRef.current) sseRef.current.close();
    setStep("FORM");
    setTx(null);
  }, []);

  const secondsLeft = useCountdown({
    seconds: ttl,
    active: step === "WAITING",
    onExpire: handleExpire,
  });

  // -------------------------------------------------------------------
  // Cleanup
  // -------------------------------------------------------------------
  useEffect(() => {
    return () => {
      if (sseRef.current) sseRef.current.close();
    };
  }, []);

  // -------------------------------------------------------------------
  // Đẩy dòng mới lên bus khi RECEIPT (Bước 5)
  // -------------------------------------------------------------------
  useEffect(() => {
    if (step !== "RECEIPT" || !tx) return;

    const row: FinanceTransaction = {
      id: `live-${tx.code}`,
      code: tx.code,
      targetType: tx.purpose === "DONATION" ? "DONOR" : "MEMBER",
      targetName: tx.payerName,
      category:
        tx.purpose === "DONATION"
          ? "CHARITY_DONATION"
          : "ANNUAL_MEMBERSHIP_FEE",
      amount: tx.amount,
      paymentMethod: "VIETQR",
      status: "COMPLETED",
      qrContent:
        tx.purpose === "DONATION"
          ? `THIENNGUYEN ${tx.payerName.replace(/\s+/g, "")}`
          : `HOIPHI2026 ${tx.payerName.replace(/\s+/g, "")}`,
      bankSender: tx.bankGateway ?? "MB Bank",
      accountMasked: "1908****8888",
      campaignName:
        tx.purpose === "DONATION"
          ? "Ủng hộ Quỹ Thiện nguyện"
          : "Nộp Niên liễm Hội phí",
      province: "Hà Nội",
      verified: true,
      createdAt: new Date().toLocaleString("vi-VN"),
      completedAt: (tx.completedAt ?? new Date()).toLocaleString("vi-VN"),
    };
    realtimeBus.emit(row);
  }, [step, tx?.code]);

  // -------------------------------------------------------------------
  // Tạo giao dịch
  // -------------------------------------------------------------------
  async function startPayment(input: {
    purpose: Purpose;
    amount: number;
    payerName: string;
    payerEmail: string;
  }) {
    if (input.amount < 10000) {
      alert("Số tiền tối thiểu 10.000 đ");
      return;
    }

    const purposeEnum =
      input.purpose === "DONATION"
        ? "CHARITY_DONATION"
        : "ANNUAL_MEMBERSHIP_FEE";

    // 1) Thử backend thật
    const res = await createPayment({
      purpose: purposeEnum,
      payerName: input.payerName,
      payerEmail: input.payerEmail,
      amount: input.amount,
      campaignSlug:
        input.purpose === "DONATION" ? "anh-sang-cong-dong" : undefined,
    });

    if (res && res.code) {
      setTtl(res.secondsLeft ?? DEFAULT_TTL_SEC);
      setTx({
        code: res.code,
        amount: res.amount ?? input.amount,
        payerName: input.payerName,
        payerEmail: input.payerEmail,
        purpose: input.purpose,
        isDemo: false,
      });
      setStep("WAITING");
      startSSE(res.code);
      return;
    }

    // 2) Fallback demo
    setTtl(DEFAULT_TTL_SEC);
    setTx({
      code: `VACHE-${input.purpose === "DONATION" ? "TN" : "HP"}-${Math.floor(
        100000 + Math.random() * 900000
      )}`,
      amount: input.amount,
      payerName: input.payerName,
      payerEmail: input.payerEmail,
      purpose: input.purpose,
      isDemo: true,
    });
    setStep("WAITING");
  }

  // -------------------------------------------------------------------
  // SSE lắng nghe webhook thật
  // -------------------------------------------------------------------
  function startSSE(code: string) {
    try {
      const es = new EventSource(
        `${API_URL}/finance/payments/${code}/stream`
      );
      sseRef.current = es;
      es.addEventListener("completed", (ev: MessageEvent) => {
        let gateway = "MB Bank";
        try {
          const data = JSON.parse(ev.data);
          gateway = data.bankGateway ?? gateway;
        } catch {
          /* noop */
        }
        finalizeSuccess(gateway, false);
        es.close();
      });
    } catch {
      /* noop */
    }
  }

  // -------------------------------------------------------------------
  // Chuyển sang SUCCESS → RECEIPT
  // -------------------------------------------------------------------
  const finalizeSuccess = useCallback(
    (gateway: string, isDemo: boolean) => {
      playDing();
      setTx((prev) =>
        prev
          ? {
              ...prev,
              bankGateway: gateway,
              completedAt: new Date(),
              isDemo,
            }
          : prev
      );
      setStep("SUCCESS");
      setTimeout(() => setStep("RECEIPT"), 2200);
    },
    []
  );

  /** Nút GIẢ LẬP — chỉ dùng cho demo */
  function simulateSuccess() {
    finalizeSuccess("MB Bank (demo)", true);
  }

  // -------------------------------------------------------------------
  // Reset
  // -------------------------------------------------------------------
  function reset() {
    if (sseRef.current) sseRef.current.close();
    setTx(null);
    setStep("FORM");
    setTtl(DEFAULT_TTL_SEC);
  }

  return {
    step,
    tx,
    secondsLeft,
    secondsFormatted: formatMmSs(secondsLeft),
    startPayment,
    simulateSuccess,
    reset,
  };
}
</file>

<file path="webcurahoi/hooks/usePaymentPrefill.tsx">
"use client";

import { createContext, useContext, useState, ReactNode } from "react";

export interface PaymentPrefill {
  purpose: "DONATION" | "MEMBERSHIP_FEE";
  amount: number;
  payerName: string;
  unitCode?: string;
}

interface PrefillContextType {
  prefill: PaymentPrefill | null;
  setPrefill: (p: PaymentPrefill | null) => void;
}

const PrefillContext = createContext<PrefillContextType | null>(null);

export function PaymentPrefillProvider({ children }: { children: ReactNode }) {
  const [prefill, setPrefill] = useState<PaymentPrefill | null>(null);
  return (
    <PrefillContext.Provider value={{ prefill, setPrefill }}>
      {children}
    </PrefillContext.Provider>
  );
}

export function usePaymentPrefill() {
  const ctx = useContext(PrefillContext);
  if (!ctx)
    throw new Error(
      "usePaymentPrefill must be used inside PaymentPrefillProvider"
    );
  return ctx;
}
</file>

<file path="webcurahoi/hooks/useStatement.ts">
"use client";

import { useEffect, useState } from "react";
import { financeApi } from "@/lib/api-client";
import { mapStatementItem } from "@/lib/api-mappers";
import { FinanceTransaction } from "@/lib/db/schema";

interface Result {
  rows: FinanceTransaction[];
  total: number;
  loading: boolean;
  source: "api" | "mock";
}

export function useStatement(limit = 200): Result {
  const [rows, setRows] = useState<FinanceTransaction[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [source, setSource] = useState<"api" | "mock">("mock");

  useEffect(() => {
    let cancelled = false;
    (async () => {
      const data = await financeApi.statement(1, limit);
      if (cancelled) return;
      if (data?.items?.length > 0) {
        setRows(data.items.map(mapStatementItem));
        setTotal(Number(data.total ?? data.items.length));
        setSource("api");
      } else {
        setRows([]);
        setTotal(0);
        setSource("mock");
      }
      setLoading(false);
    })();
    return () => {
      cancelled = true;
    };
  }, [limit]);

  return { rows, total, loading, source };
}
</file>

