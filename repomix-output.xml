  AlertCircle,
  Building2,
  User,
  Receipt,
  Inbox,
} from "lucide-react";
import { financeApi, FeeScheduleItem } from "@/lib/api-client";

function formatVnd(n: number | null): string {
  if (n == null) return "Theo QĐ Trung ương Hội";
  return new Intl.NumberFormat("vi-VN").format(n) + " đ";
}

function formatRange(min: number | null, max: number | null): string {
  if (min == null && max == null) return "Đang cập nhật";
  if (min != null && max != null && min !== max) {
    return `${formatVnd(min)} – ${formatVnd(max)}`;
  }
  return formatVnd(min ?? max);
}

export default function FeeScheduleTab() {
  const [schedules, setSchedules] = useState<FeeScheduleItem[]>([]);
  const [documents, setDocuments] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState("");
  const [categoryFilter, setCategoryFilter] = useState<
    "ALL" | "ANNUAL_MEMBERSHIP_FEE" | "ESTABLISHMENT_FEE"
  >("ALL");

  useEffect(() => {
    let cancelled = false;
    (async () => {
      const [s, d] = await Promise.all([
        financeApi.feeSchedules(),
        financeApi.documents(),
      ]);
      if (!cancelled && s) setSchedules(s);
      if (!cancelled && d) {
        setDocuments(
          d.map((x) => ({
            id: x.id,
            code: x.code ?? "",
            title: x.title,
            documentType: x.docType ?? "REGULATION",
            issuedDate: x.issuedDate ?? "",
            fileUrl: x.fileUrl ?? "#",
          }))
        );
      }
      if (!cancelled) setLoading(false);
    })();
    return () => {
      cancelled = true;
    };
  }, []);

  const filteredSchedules = useMemo(() => {
    return schedules.filter((s) => {
      const matchCat = categoryFilter === "ALL" || s.category === categoryFilter;
      const q = searchTerm.trim().toLowerCase();
      const matchSearch =
        q === "" ||
        s.name.toLowerCase().includes(q) ||
        s.code.toLowerCase().includes(q);
      return matchCat && matchSearch;
    });
  }, [schedules, categoryFilter, searchTerm]);

  return (
    <div className="space-y-12">
      {/* 1. BIỂU MỨC PHÍ */}
      <section className="space-y-4">
        <div className="border-b-2 border-[#991b1b] pb-2 flex flex-col sm:flex-row justify-between sm:items-end gap-2">
          <div>
            <span className="text-xs font-bold text-[#991b1b] uppercase tracking-wider block">
              Trụ Cột 1 — Đáp ứng Mục 1 Nghiệp Vụ Mảng V
            </span>
            <h2 className="text-xl sm:text-2xl font-bold text-slate-900 font-serif">
              BIỂU MỨC PHÍ THÀNH LẬP & HỘI PHÍ NIÊN LIỄM
            </h2>
          </div>
          <span className="text-xs text-slate-500">Nhiệm kỳ 2021 – 2026</span>
        </div>

        <div className="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center bg-white p-3 rounded-xs border border-slate-300 text-xs">
          <div className="relative w-full sm:w-80">
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              placeholder="Tìm theo tên hoặc mã biểu phí..."
              className="w-full pl-8 pr-3 py-2 border border-slate-300 rounded-xs focus:outline-none focus:ring-1 focus:ring-red-600"
            />
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" />
          </div>
          <div className="flex items-center gap-2">
            <Filter className="w-3.5 h-3.5 text-slate-400 shrink-0" />
            <select
              value={categoryFilter}
              onChange={(e) => setCategoryFilter(e.target.value as any)}
              className="border border-slate-300 rounded-xs px-3 py-2 bg-white text-slate-700 focus:outline-none"
            >
              <option value="ALL">Tất cả loại phí</option>
              <option value="ANNUAL_MEMBERSHIP_FEE">Hội phí niên liễm</option>
              <option value="ESTABLISHMENT_FEE">Phí thành lập đơn vị</option>
            </select>
          </div>
        </div>

        {loading ? (
          <div className="p-10 text-center text-slate-400 text-sm bg-white border border-slate-300 rounded-xs">
            Đang tải biểu mức phí...
          </div>
        ) : filteredSchedules.length === 0 ? (
          <div className="p-10 text-center bg-white border border-dashed border-slate-300 rounded-xs">
            <Inbox className="w-10 h-10 text-slate-300 mx-auto mb-2" />
            <p className="font-bold text-slate-600 text-sm">
              Chưa có biểu mức phí nào
            </p>
            <p className="text-xs text-slate-500 mt-1">
              Ban Tài chính & Quỹ chưa cập nhật biểu phí vào hệ thống.
            </p>
          </div>
        ) : (
          <div className="overflow-x-auto border border-slate-300 rounded-xs bg-white">
            <table className="w-full text-left text-xs min-w-[720px]">
              <thead className="bg-[#f8fafc] text-slate-800 font-bold border-b border-slate-300 uppercase text-[10.5px] tracking-wider">
                <tr>
                  <th className="py-2.5 px-3 w-32">Mã</th>
                  <th className="py-2.5 px-3">Tên loại phí / hội phí</th>
                  <th className="py-2.5 px-3 w-40">Đối tượng</th>
                  <th className="py-2.5 px-3 w-60 text-right">Định mức</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-200">
                {filteredSchedules.map((s) => (
                  <tr key={s.code} className="hover:bg-slate-50">
                    <td className="py-3 px-3 font-mono font-bold text-[#991b1b] whitespace-nowrap">
                      {s.code}
                    </td>
                    <td className="py-3 px-3">
                      <div className="font-bold text-slate-900 font-serif">
                        {s.name}
                      </div>
                      {s.note && (
                        <div className="text-[11px] text-slate-500 italic mt-0.5 leading-snug">
                          {s.note}
                        </div>
                      )}
                    </td>
                    <td className="py-3 px-3 whitespace-nowrap">
                      {s.targetGroup === "ORGANIZATION" ? (
                        <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200">
                          <Building2 className="w-3 h-3" /> Tập thể
                        </span>
                      ) : s.targetGroup === "INDIVIDUAL" ? (
                        <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                          <User className="w-3 h-3" /> Cá nhân
                        </span>
                      ) : (
                        <span className="text-slate-400">—</span>
                      )}
                    </td>
                    <td className="py-3 px-3 text-right font-mono font-bold text-slate-900 whitespace-nowrap">
                      {s.category === "ESTABLISHMENT_FEE"
                        ? formatVnd(s.minAmount ?? s.maxAmount)
                        : formatRange(s.minAmount, s.maxAmount)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <div className="bg-amber-50 border border-amber-300 rounded-xs p-3 text-[11px] text-amber-900 flex items-start gap-2">
          <AlertCircle className="w-4 h-4 text-amber-700 shrink-0 mt-0.5" />
          <span>
            Mức thu nêu trên được quy định tại Nghị quyết Ban Chấp hành Trung
            ương Hội nhiệm kỳ 2021 – 2026. Chính sách miễn giảm áp dụng cho sinh
            viên y khoa, hội viên cao tuổi và hoàn cảnh đặc biệt khó khăn.
          </span>
        </div>
      </section>

      {/* 2. KHO VĂN BẢN */}
      <section className="space-y-4">
        <div className="border-b-2 border-slate-800 pb-2">
          <span className="text-xs font-bold text-[#991b1b] uppercase tracking-wider block">
            Kho Văn Bản Pháp Quy Chính Thức
          </span>
          <h2 className="text-xl sm:text-2xl font-bold text-slate-900 font-serif">
            QUY CHẾ & NGHỊ QUYẾT VỀ QUẢN LÝ TÀI CHÍNH
          </h2>
        </div>

        {loading ? (
          <div className="p-8 text-center text-slate-400 text-sm">
            Đang tải kho văn bản...
          </div>
        ) : documents.length === 0 ? (
          <div className="p-10 text-center bg-white border border-dashed border-slate-300 rounded-xs">
            <Inbox className="w-10 h-10 text-slate-300 mx-auto mb-2" />
            <p className="font-bold text-slate-600 text-sm">
              Chưa có văn bản nào
            </p>
            <p className="text-xs text-slate-500 mt-1">
              Kho văn bản pháp quy sẽ hiển thị khi Trung ương Hội đăng tải.
            </p>
          </div>
        ) : (
          <div className="space-y-3">
            {documents.map((doc) => (
              <div
                key={doc.id}
                className="p-4 bg-white rounded-xs border border-slate-300 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:border-red-400 transition-colors"
              >
                <div className="flex items-start gap-3 min-w-0">
                  <div className="w-10 h-10 rounded-xs bg-red-50 border border-red-200 text-[#991b1b] flex items-center justify-center shrink-0">
                    <Receipt className="w-5 h-5" />
                  </div>
                  <div className="min-w-0">
                    {doc.code && (
                      <span className="font-mono text-[11px] font-bold text-[#991b1b] block">
                        Số: {doc.code}
                      </span>
                    )}
                    <h4 className="font-bold text-sm text-slate-900 font-serif leading-snug">
                      {doc.title}
                    </h4>
                    {doc.issuedDate && (
                      <p className="text-[11px] text-slate-500 mt-0.5 font-mono">
                        Ngày ban hành: {doc.issuedDate}
                      </p>
                    )}
                  </div>
                </div>
                <a
                  href={doc.fileUrl || "#"}
                  className="shrink-0 self-start sm:self-auto px-3 py-1.5 bg-[#991b1b] hover:bg-red-800 text-white rounded-xs font-bold text-xs flex items-center gap-1.5 transition-colors"
                >
                  <Download className="w-3.5 h-3.5" /> Tải PDF
                </a>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  );
}
</file>

<file path="webcurahoi/components/finance/PaymentTerminalTab.tsx">
"use client";

import React from "react";
import PublicFinanceStatement from "@/components/finance/PublicFinanceStatement";
import CampaignCards from "./campaign/CampaignCards";
import DisbursementsSection from "./campaign/DisbursementsSection";
import HonorRoll from "./campaign/HonorRoll";
import { usePaymentFlow } from "@/hooks/usePaymentFlow";
import { usePaymentPrefill } from "@/hooks/usePaymentPrefill";
import PaymentStepProgress from "./payment/PaymentStepProgress";
import PaymentFormStep from "./payment/PaymentFormStep";
import PaymentWaitingStep from "./payment/PaymentWaitingStep";
import PaymentSuccessStep from "./payment/PaymentSuccessStep";
import PaymentReceiptStep from "./payment/PaymentReceiptStep";

export default function PaymentTerminalTab() {
  const {
    step,
    tx,
    secondsFormatted,
    startPayment,
    simulateSuccess,
    reset,
  } = usePaymentFlow();

  const { prefill, setPrefill } = usePaymentPrefill();

  return (
    <div className="space-y-12">
      {/* ============================================================
          KHỐI CHIẾN DỊCH THIỆN NGUYỆN (Trụ cột 3 — đầu trang)
      ============================================================ */}
      <CampaignCards />

      {/* ============================================================
          THANH TIẾN TRÌNH 5 BƯỚC CỦA CỔNG THANH TOÁN
      ============================================================ */}
      <PaymentStepProgress step={step} />

      {/* ============================================================
          BƯỚC 1: FORM NHẬP THÔNG TIN
      ============================================================ */}
      {step === "FORM" && (
        <PaymentFormStep
          onSubmit={(input) => {
            // Xóa prefill sau khi dùng để tránh dính lại lần sau
            setPrefill(null);
            startPayment(input);
          }}
          initialPurpose={prefill?.purpose}
          initialAmount={prefill?.amount}
          initialName={prefill?.payerName}
        />
      )}

      {/* ============================================================
          BƯỚC 2: CHỜ THANH TOÁN — QR + RADAR + ĐẾM NGƯỢC
      ============================================================ */}
      {step === "WAITING" && tx && (
        <PaymentWaitingStep
          tx={tx}
          secondsFormatted={secondsFormatted}
          onSimulate={simulateSuccess}
          onCancel={reset}
        />
      )}

      {/* ============================================================
          BƯỚC 3: NỔ MÀN HÌNH THÀNH CÔNG
      ============================================================ */}
      {step === "SUCCESS" && tx && <PaymentSuccessStep tx={tx} />}

      {/* ============================================================
          BƯỚC 4 + 5: BIÊN LAI ĐIỆN TỬ + CTA ĐẨY LÊN SAO KÊ
      ============================================================ */}
      {step === "RECEIPT" && tx && (
        <PaymentReceiptStep tx={tx} onReset={reset} />
      )}

      {/* ============================================================
          BẢNG SAO KÊ CÔNG KHAI (dòng thu vào realtime)
      ============================================================ */}
      <section id="sao-ke-minh-bach" className="space-y-4 pt-4">
        <div className="border-b-2 border-slate-800 pb-2 flex flex-col sm:flex-row justify-between sm:items-end gap-2">
          <div>
            <span className="text-xs font-bold text-[#991b1b] uppercase tracking-wider block">
              Minh Bạch Tài Chính Thời Gian Thực
            </span>
            <h2 className="text-xl sm:text-2xl font-bold text-slate-900 font-serif">
              BẢN SAO KÊ CÔNG KHAI CÁC GIAO DỊCH TOÀN QUỐC
            </h2>
          </div>
          <p className="text-xs text-slate-500">
            Dữ liệu tự động cập nhật liên tục qua liên minh Napas & MB Bank
          </p>
        </div>

        <PublicFinanceStatement />
      </section>

      {/* ============================================================
          BÁO CÁO GIẢI NGÂN CHI RA (Minh bạch hai chiều)
      ============================================================ */}
      <DisbursementsSection />

      {/* ============================================================
          BẢNG VÀNG TRI ÂN NHÀ HẢO TÂM
      ============================================================ */}
      <HonorRoll />
    </div>
  );
}
</file>

<file path="webcurahoi/components/finance/UnitFeeLookupTab.tsx">
"use client";

import React, { useState } from "react";
import {
  Search,
  Building2,
  CheckCircle2,
  AlertCircle,
  Clock,
  Receipt,
  QrCode,
  FileText,
  Download,
} from "lucide-react";
import {
  financeApi,
  UnitStatusResponse,
  UnitPaymentRow,
} from "@/lib/api-client";
import CertificateModal from "./certificate/CertificateModal";
import { PaymentPrefill } from "@/hooks/usePaymentPrefill";

interface Props {
  onGoToPayment?: (prefill: PaymentPrefill) => void;
}

export default function UnitFeeLookupTab({ onGoToPayment }: Props) {
  const [code, setCode] = useState("");
  const [status, setStatus] = useState<UnitStatusResponse | null>(null);
  const [payments, setPayments] = useState<UnitPaymentRow[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [certificate, setCertificate] = useState<any | null>(null);
  const [issuingCert, setIssuingCert] = useState(false);

  const handleLookup = async (e: React.FormEvent) => {
    e.preventDefault();
    const clean = code.trim().toUpperCase();
    if (!clean) return;

    setLoading(true);
    setError(null);
    setStatus(null);
    setPayments([]);

    const [s, p] = await Promise.all([
      financeApi.unitStatus(clean),
      financeApi.unitPayments(clean),
    ]);

    setLoading(false);

    if (!s) {
      setError(
        `Không tìm thấy đơn vị có mã "${clean}". Vui lòng kiểm tra lại hoặc liên hệ Văn phòng Trung ương Hội.`
      );
      return;
    }

    setStatus(s);
    setPayments(p ?? []);
  };

  const handleQuickFill = (sampleCode: string) => {
    setCode(sampleCode);
  };

  /** Mở chứng nhận PDF của năm tương ứng */
  async function handleOpenCertificate(year: number) {
    if (!status) return;
    setIssuingCert(true);
    try {
      const API =
        process.env.NEXT_PUBLIC_API_URL ?? "http://localhost:4000/api";

      // 1. Thử lấy chứng nhận đã có
      let res = await fetch(
        `${API}/finance/units/${status.unit.code}/certificates/${year}`
      );

      // 2. Nếu chưa có → cấp mới
      if (!res.ok) {
        res = await fetch(
          `${API}/finance/units/${status.unit.code}/certificates/${year}/issue`,
          { method: "POST" }
        );
      }

      if (!res.ok) throw new Error("Không thể lấy chứng nhận");
      const data = await res.json();
      setCertificate(data);
    } catch (e: any) {
      alert(`Lỗi: ${e.message}`);
    } finally {
      setIssuingCert(false);
    }
  }

  /** Bấm "Tạo QR nộp ngay" → nhảy sang Tab 3 với dữ liệu điền sẵn */
  function handleGoToPayment() {
    if (!status || !status.reminder || !onGoToPayment) {
      // Fallback nếu không có callback
      window.location.hash = "cong-chuyen-khoan";
      window.scrollTo({ top: 0, behavior: "smooth" });
      return;
    }
    onGoToPayment({
      purpose: "MEMBERSHIP_FEE",
      amount: status.reminder.amountRemaining,
      payerName: status.unit.name,
      unitCode: status.unit.code,
    });
  }

  return (
    <div className="space-y-8">
      {/* KHỐI TRA CỨU */}
      <section className="bg-white border border-slate-300 rounded-xs shadow-2xs p-5 sm:p-6 space-y-4">
        <div className="border-b border-slate-200 pb-3">
          <span className="text-xs font-bold text-[#991b1b] uppercase tracking-wider block">
            Trụ Cột 2 — Đáp ứng Mục 2 Nghiệp Vụ Mảng V
          </span>
          <h2 className="text-lg sm:text-xl font-bold text-slate-900 font-serif mt-0.5">
            TRA CỨU TÌNH TRẠNG HỘI PHÍ THEO MÃ ĐƠN VỊ
          </h2>
          <p className="text-xs text-slate-500 mt-0.5">
            Dành cho Chi hội, Liên Chi hội, Viện, Trung tâm và Doanh nghiệp hội
            viên. Nhập mã đơn vị để xem trạng thái đóng niên liễm và lịch sử
            giao dịch.
          </p>
        </div>

        <form onSubmit={handleLookup} className="flex flex-col sm:flex-row gap-3">
          <div className="relative flex-1">
            <input
              type="text"
              value={code}
              onChange={(e) => setCode(e.target.value)}
              placeholder="VD: CH-DANANG, VIEN-YSH01, DN-AOVUA..."
              className="w-full pl-9 pr-3 py-2.5 border border-slate-300 rounded-xs focus:outline-none focus:ring-1 focus:ring-[#991b1b] font-mono text-sm"
            />
            <Search className="w-4 h-4 text-slate-400 absolute left-3 top-3" />
          </div>
          <button
            type="submit"
            disabled={loading || !code.trim()}
            className="px-6 py-2.5 bg-[#991b1b] hover:bg-red-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white rounded-xs font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-1.5"
          >
            {loading ? (
              <>
                <Clock className="w-4 h-4 animate-spin" /> Đang tra cứu...
              </>
            ) : (
              <>
                <Search className="w-4 h-4" /> Tra cứu ngay
              </>
            )}
          </button>
        </form>

        <div className="flex flex-wrap items-center gap-2 text-[11px] text-slate-500">
          <span className="font-bold text-slate-700">Mã mẫu thử:</span>
          {["CH-DANANG", "VIEN-YSH01", "DN-AOVUA"].map((c) => (
            <button
              key={c}
              type="button"
              onClick={() => handleQuickFill(c)}
              className="px-2 py-0.5 bg-slate-100 hover:bg-red-50 hover:text-[#991b1b] border border-slate-200 rounded-xs font-mono font-bold transition-colors cursor-pointer"
            >
              {c}
            </button>
          ))}
        </div>
      </section>

      {/* LỖI */}
      {error && (
        <div className="p-4 bg-amber-50 border border-amber-300 rounded-xs text-xs text-amber-900 flex items-start gap-2.5">
          <AlertCircle className="w-5 h-5 text-amber-700 shrink-0" />
          <div>
            <strong>Không tra cứu được:</strong>
            <p className="mt-0.5">{error}</p>
          </div>
        </div>
      )}

      {/* KẾT QUẢ */}
      {status && (
        <div className="space-y-6">
          <section className="bg-white border border-slate-300 rounded-xs shadow-2xs overflow-hidden">
            <div className="p-5 bg-slate-50 border-b border-slate-200 flex items-start gap-4">
              <div className="w-12 h-12 rounded-xs bg-[#991b1b] text-white flex items-center justify-center shrink-0">
                <Building2 className="w-6 h-6" />
              </div>
              <div className="flex-1 min-w-0">
                <span className="font-mono text-xs font-bold text-[#991b1b] block">
                  {status.unit.code}
                </span>
                <h3 className="font-bold text-base text-slate-900 font-serif leading-snug">
                  {status.unit.name}
                </h3>
                <p className="text-[11px] text-slate-500 mt-0.5">
                  {status.unit.province && <>Địa bàn: {status.unit.province}</>}
                </p>
              </div>
            </div>

            <div className="p-5 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
              <div className="space-y-1">
                <span className="text-slate-500 block text-[11px] uppercase tracking-wide font-bold">
                  Trạng thái
                </span>
                {status.status === "COMPLETED" ? (
                  <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-xs bg-emerald-50 text-emerald-800 text-sm font-bold border border-emerald-300">
                    <CheckCircle2 className="w-4 h-4" /> Đã hoàn thành
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-xs bg-amber-50 text-amber-900 text-sm font-bold border border-amber-300">
                    <AlertCircle className="w-4 h-4" /> Chưa hoàn thành
                  </span>
                )}
              </div>

              <div className="space-y-1">
                <span className="text-slate-500 block text-[11px] uppercase tracking-wide font-bold">
                  Các năm đã đóng đủ
                </span>
                <span className="font-mono text-sm text-slate-900">
                  {status.paidYears.length > 0
                    ? status.paidYears.sort((a, b) => a - b).join(", ")
                    : "—"}
                </span>
              </div>

              <div className="space-y-1">
                <span className="text-slate-500 block text-[11px] uppercase tracking-wide font-bold">
                  Tổng còn nợ
                </span>
                <span
                  className={`font-mono text-base font-black ${
                    status.totalOutstanding > 0
                      ? "text-[#991b1b]"
                      : "text-emerald-700"
                  }`}
                >
                  {new Intl.NumberFormat("vi-VN").format(
                    status.totalOutstanding
                  )}{" "}
                  đ
                </span>
              </div>
            </div>

            {status.reminder && (
              <div
                className={`p-4 border-t text-xs flex items-start gap-2.5 ${
                  status.reminder.overdue
                    ? "bg-red-50 border-red-200 text-red-900"
                    : "bg-amber-50 border-amber-200 text-amber-900"
                }`}
              >
                {status.reminder.overdue ? (
                  <AlertCircle className="w-5 h-5 shrink-0 text-red-700" />
                ) : (
                  <Clock className="w-5 h-5 shrink-0 text-amber-700" />
                )}
                <div className="flex-1">
                  <p className="font-bold">{status.reminder.message}</p>
                  <p className="text-[11px] mt-0.5 opacity-90">
                    Số tiền cần nộp còn lại:{" "}
                    <strong className="font-mono">
                      {new Intl.NumberFormat("vi-VN").format(
                        status.reminder.amountRemaining
                      )}{" "}
                      đ
                    </strong>
                  </p>
                </div>
                <button
                  onClick={handleGoToPayment}
                  className="shrink-0 self-start px-4 py-2 bg-[#991b1b] hover:bg-red-800 text-white rounded-xs font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer"
                >
                  <QrCode className="w-4 h-4" /> Tạo QR nộp ngay
                </button>
              </div>
            )}
          </section>

          <section className="bg-white border border-slate-300 rounded-xs shadow-2xs overflow-hidden">
            <div className="p-4 border-b border-slate-200 text-xs font-bold text-slate-800">
              Bảng Nghĩa Vụ Hội Phí Theo Năm
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-xs min-w-[640px]">
                <thead className="bg-[#f8fafc] text-slate-700 font-bold border-b border-slate-300 uppercase text-[10.5px]">
                  <tr>
                    <th className="py-2.5 px-3 text-left w-24">Năm</th>
                    <th className="py-2.5 px-3 text-right">Phải nộp</th>
                    <th className="py-2.5 px-3 text-right">Đã nộp</th>
                    <th className="py-2.5 px-3 text-right">Còn lại</th>
                    <th className="py-2.5 px-3 text-center w-40">Trạng thái</th>
                    <th className="py-2.5 px-3 text-center w-32">Chứng nhận</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-200">
                  {status.obligations.map((o) => (
                    <tr key={o.year} className="hover:bg-slate-50">
                      <td className="py-2.5 px-3 font-mono font-bold text-slate-900">
                        {o.year}
                      </td>
                      <td className="py-2.5 px-3 text-right font-mono text-slate-800">
                        {new Intl.NumberFormat("vi-VN").format(o.amountDue)} đ
                      </td>
                      <td className="py-2.5 px-3 text-right font-mono text-emerald-700 font-bold">
                        {new Intl.NumberFormat("vi-VN").format(o.amountPaid)} đ
                      </td>
                      <td className="py-2.5 px-3 text-right font-mono text-[#991b1b] font-bold">
                        {new Intl.NumberFormat("vi-VN").format(
                          o.amountRemaining
                        )}{" "}
                        đ
                      </td>
                      <td className="py-2.5 px-3 text-center">
                        {o.status === "PAID" ? (
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-300">
                            <CheckCircle2 className="w-3 h-3" /> Đã đóng đủ
                          </span>
                        ) : o.status === "PARTIAL" ? (
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200">
                            Đóng một phần
                          </span>
                        ) : (
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-900 border border-amber-300">
                            <AlertCircle className="w-3 h-3" /> Chưa đóng
                          </span>
                        )}
                      </td>
                      <td className="py-2.5 px-3 text-center">
                        {o.status === "PAID" ? (
                          <button
                            onClick={() => handleOpenCertificate(o.year)}
                            disabled={issuingCert}
                            className="inline-flex items-center gap-1 px-2 py-1 bg-red-50 hover:bg-red-100 disabled:bg-slate-100 text-[#991b1b] rounded-xs text-[10px] font-bold border border-red-200 transition-colors cursor-pointer disabled:cursor-wait"
                          >
                            <Download className="w-3 h-3" />{" "}
                            {issuingCert ? "Đang xử lý..." : "PDF"}
                          </button>
                        ) : (
                          <span className="text-slate-300 text-[10px]">—</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {payments.length > 0 && (
            <section className="bg-white border border-slate-300 rounded-xs shadow-2xs overflow-hidden">
              <div className="p-4 border-b border-slate-200 text-xs font-bold text-slate-800 flex items-center gap-2">
                <Receipt className="w-4 h-4 text-[#991b1b]" /> Lịch Sử Giao
                Dịch Đã Hoàn Tất
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-xs min-w-[640px]">
                  <thead className="bg-[#f8fafc] text-slate-700 font-bold border-b border-slate-300 uppercase text-[10.5px]">
                    <tr>
                      <th className="py-2.5 px-3 text-left w-40">Mã giao dịch</th>
                      <th className="py-2.5 px-3 text-left">Mục đích</th>
                      <th className="py-2.5 px-3 text-right w-32">Số tiền</th>
                      <th className="py-2.5 px-3 text-center w-32">Ngân hàng</th>
                      <th className="py-2.5 px-3 text-center w-40">Thời gian</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200">
                    {payments.map((p) => (
                      <tr key={p.code} className="hover:bg-slate-50">
                        <td className="py-2.5 px-3 font-mono font-bold text-[#991b1b]">
                          {p.code}
                        </td>
                        <td className="py-2.5 px-3 text-slate-700">
                          {p.purpose}
                        </td>
                        <td className="py-2.5 px-3 text-right font-mono font-bold text-slate-900">
                          {new Intl.NumberFormat("vi-VN").format(p.amount)} đ
                        </td>
                        <td className="py-2.5 px-3 text-center text-slate-600">
                          {p.bankGateway ?? "—"}
                        </td>
                        <td className="py-2.5 px-3 text-center font-mono text-[11px] text-slate-500">
                          {new Date(p.completedAt).toLocaleString("vi-VN")}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>
      )}

      {!status && !error && !loading && (
        <section className="bg-slate-50 border border-dashed border-slate-300 rounded-xs p-8 text-center">
          <FileText className="w-10 h-10 text-slate-400 mx-auto mb-3" />
          <h3 className="font-bold text-sm text-slate-700">
            Nhập mã đơn vị để bắt đầu tra cứu
          </h3>
          <p className="text-xs text-slate-500 mt-1 max-w-md mx-auto">
            Hệ thống sẽ hiển thị tình trạng đóng niên liễm các năm, số tiền còn
            nợ, nhắc nhở hạn quyết toán và lịch sử giao dịch chi tiết.
          </p>
        </section>
      )}

      {certificate && (
        <CertificateModal
          data={certificate}
          onClose={() => setCertificate(null)}
        />
      )}
    </div>
  );
}
</file>

